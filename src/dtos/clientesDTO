// DTO = limpa e valida o que vem do front, não deixa vazar a senha
function semSenha(cliente) {
  if (!cliente) return null;
  const { senha, ...resto } = cliente;
  return resto;
}

function cadastroDTO(body) {
  const { nome, email, senha, cidade } = body || {};
  if (!nome || !email || !senha) return { erro: "Preencha nome, email e senha" };
  return { nome, email, senha, cidade: cidade || "Hugo Napoleão - PI" };
}

function loginDTO(body) {
  const { email, senha } = body || {};
  if (!email || !senha) return { erro: "Preencha email e senha" };
  return { email, senha };
}

function atualizarPerfilDTO(body) {
  const { nome, cidade, email } = body || {};
  return { nome, cidade, email };
}

function avaliacaoDTO(body) {
  const { profissionalId, clienteId, nota, comentario } = body || {};
  if (!profissionalId || !nota) return { erro: "Preencha profissional e nota" };
  return { profissionalId, clienteId, nota, comentario };
}

module.exports = { semSenha, cadastroDTO, loginDTO, atualizarPerfilDTO, avaliacaoDTO };
